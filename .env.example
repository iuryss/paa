# Copie para .env e ajuste. NUNCA commite o .env.

# --- Banco (usado pelo docker-compose e pelo Prisma) ---
POSTGRES_USER=tea
POSTGRES_PASSWORD=tea_dev_password
POSTGRES_DB=tea_platform
POSTGRES_PORT=5433
DATABASE_URL="postgresql://tea:tea_dev_password@localhost:5433/tea_platform?schema=public"

# --- Auth.js (Etapa 2) ---
# Gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-com-32+-caracteres-aleatorios"
AUTH_URL="http://localhost:3000"

# --- App ---
NODE_ENV=development
LOG_LEVEL=info

# Atrás de proxy reverso/container (Vercel já resolve sozinho): confia no cabeçalho Host.
# AUTH_TRUST_HOST=true

# --- E-mail (redefinição de senha e convites) ---
# "console": mostra o e-mail no terminal do servidor (só desenvolvimento, nada é enviado).
# "gmail":   GRÁTIS, sem domínio. Conta Gmail + SENHA DE APP (guia em docs/DEPLOY.md, seção "E-mail gratuito com Gmail").
# "resend":  exige domínio verificado no Resend.   "smtp": qualquer servidor SMTP.
EMAIL_PROVIDER=console
# GMAIL_USER=plataforma.escola@gmail.com
# GMAIL_APP_PASSWORD="abcd efgh ijkl mnop"
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# EMAIL_FROM="Plataforma TEA <nao-responda@suaescola.com.br>"   (opcional no Gmail)

# --- Textos legais (/privacidade e /termo) ---
# Quem é o controlador e como falar com o encarregado (DPO). LEGAL_REVIEWED=true remove o aviso
# "versão de trabalho" depois que o jurídico aprovar os textos (src/content/legal.ts).
LEGAL_CONTROLLER_NAME="Escola Exemplo"
LEGAL_DPO_EMAIL="privacidade@escola-exemplo.test"
LEGAL_REVIEWED=false

# --- Limite de tentativas de login (Redis do Upstash) ---
# Sem estas variáveis o limite fica em memória (ok no seu computador). Na Vercel/produção, configure:
# crie o Redis em Vercel -> Storage -> Upstash (o painel já injeta as variáveis no projeto).
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxx
# (O antigo Vercel KV usa KV_REST_API_URL e KV_REST_API_TOKEN; ambos funcionam.)
